# =============================================================================
# InsightFlow AI — backend configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# =============================================================================

# --- Application ------------------------------------------------------------
# "development" enables verbose errors and auto-created tables.
# "production" enforces secret validation and disables permissive defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Pretty console logs in dev; set to true for one-line JSON logs (production).
LOG_JSON=false

# --- Database ---------------------------------------------------------------
# Leave blank for zero-setup local development: a SQLite file is created at
# backend/storage/insightflow.db.
# PostgreSQL (recommended for production):
#   DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow
#
# Neon hands out `postgresql://...`; both that and `postgres://...` are accepted
# and routed to the psycopg 3 driver we ship, so paste whichever you are given.
#
# On a serverless host use Neon's **pooled** string — the hostname containing
# `-pooler`. Every warm instance keeps its own connection pool, they multiply
# with concurrency, and the free plan's direct connection limit is reached long
# before the traffic is interesting. The pooler exists for exactly this shape.
DATABASE_URL=

# Connection pool size, per process. The defaults below suit one long-lived
# server. A serverless deployment wants them smaller, because every warm
# instance keeps its own pool and they multiply as the platform adds instances:
#   DB_POOL_SIZE=5
#   DB_MAX_OVERFLOW=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Create any missing tables from the models at start-up.
#
# A convenience for development, where there is no migration step. Alembic owns
# the schema in production, and this switches itself off when
# ENVIRONMENT=production so that a missing migration fails loudly instead of
# being papered over. Set it explicitly only if you mean to override that.
# AUTO_CREATE_TABLES=true

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins allowed to call the API directly (browser CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Identifying the caller -------------------------------------------------
# Rate limiting and audit logging both need to know who is calling. By default
# only the socket address is trusted, because `X-Forwarded-For` is written by
# whoever sends the request and rotating it would defeat every per-client limit.
#
# TRUSTED_PROXY_COUNT: how many reverse proxies sit in front of this service
# (nginx, Caddy, a platform load balancer). 0 disables the header entirely.
TRUSTED_PROXY_COUNT=0
#
# PROXY_SHARED_SECRET: shared with the Next.js layer. In production every
# request reaches this API from the frontend's servers, so without this the
# whole product shares one rate-limit budget. Set the SAME value here and as
# PROXY_SHARED_SECRET in the frontend environment. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
PROXY_SHARED_SECRET=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Generic API budget, per client per window.
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
# Stricter budget for authentication endpoints (brute-force protection).
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- File uploads -----------------------------------------------------------
# Where uploaded files are kept.
#
#   local    — a directory (STORAGE_DIR below). Correct for a laptop, a
#              container with a volume, or a VM. The default.
#   database — rows in PostgreSQL, alongside the analysis they belong to.
#
# The product re-reads the original file long after the upload: `Ask` executes
# a query plan against the rows and `Investigate` slices the dataset to explain
# an anomaly. So this is durable state, not a temporary input. Use `database`
# on any host whose filesystem is private to one instance or erased without
# notice — every serverless platform, and a free container tier with no disk.
# With `local` on such a host, a dataset stays listed and visible while `Ask`
# and `Investigate` report that its file is gone.
#
# The cost of `database` is honest and bounded: PostgreSQL is not object
# storage, so uploads consume the same quota as the analysis results. Sized
# against MAX_UPLOAD_SIZE_MB below, and against 0.5 GB on Neon's free plan.
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Largest upload accepted, enforced by reading no further than this many bytes.
#
# Keep at or below what the platform in front of this service will pass: a
# Vercel Function rejects a request body over 4.5 MB itself, with its own error,
# before this application sees it. Set 4 there, and set NEXT_PUBLIC_MAX_UPLOAD_MB
# to match so the browser explains the limit in the product's own words.
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.tsv
# Rows scanned for type inference during profiling (0 = whole file).
PROFILE_SAMPLE_ROWS=50000
# Hard ceiling on rows retained for analysis; larger files are down-sampled
# with a clearly-communicated notice.
MAX_ANALYSIS_ROWS=500000

# --- Analysis jobs ----------------------------------------------------------
# How an analysis actually runs.
#
#   thread  — a bounded pool inside this process. The request that starts an
#             analysis returns immediately and the work continues behind it.
#             Correct for anything that is a running server.
#   request — the work happens inside an explicit POST /analyses/{id}/run,
#             which the client sends once and the progress poll reports on.
#             Required on serverless platforms: they may freeze or discard an
#             instance the moment it has answered, so a thread started behind a
#             response is not merely slower, it may never be scheduled — and
#             the analysis would sit queued forever with no error to explain
#             it. The user-visible flow is identical either way.
#
# In `request` mode one analysis must fit inside the platform's function
# timeout (300s on Vercel). Lower MAX_ANALYSIS_ROWS if your files are large
# enough to approach that.
ANALYSIS_EXECUTION=thread
ANALYSIS_WORKERS=2
ANALYSIS_TIMEOUT_SECONDS=600
# A job still "running" after this many minutes is considered orphaned.
ANALYSIS_STALE_MINUTES=30

# --- Start-up ---------------------------------------------------------------
# Run the housekeeping in the start-up hook: reconcile interrupted analyses,
# purge expired demo workspaces, warm a local model.
#
# On a server this happens once per boot and costs nothing. Where every cold
# start is a new process it becomes a tax on unpredictable requests, and the
# model warm-up is pointless there anyway. Each task has another trigger — a
# stale analysis is failed when it is polled, demo sessions are purged whenever
# a demo is created — so switching this off loses only the head start.
STARTUP_TASKS_ENABLED=true

# --- AI provider ------------------------------------------------------------
# one of: ollama | openai | none
AI_PROVIDER=ollama
AI_ENABLED=true
# Local CPU inference is slow. The backend warms the model at start-up, but
# allow headroom for the first request after a cold start.
#
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1

# Ceiling for everything one request asks of the model, retries and JSON
# repair included. This is the number that matters: a request must finish
# within 300 seconds, because that is when Node stops waiting for response
# headers, and it cannot be raised from a Next.js route handler. Go over it
# and the user is told the service is unreachable while it is answering them.
# AI_TIMEOUT_SECONDS alone cannot bound a request — one call is up to four
# round trips — so this is enforced separately and must stay under 300.
AI_REQUEST_BUDGET_SECONDS=240
# Maximum raw rows that may ever be sent to the model (privacy ceiling).
AI_MAX_SAMPLE_ROWS=25

# Ollama (local development — no data leaves your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# OpenAI-compatible endpoint. "openai" here names the *protocol*, not the
# vendor: any server speaking POST /chat/completions works, and no code changes
# when you switch between them. Pick one of the blocks below.
#
# --- A hosted model, free tier (recommended for a deployed demo) ------------
# Groq serves open models on an OpenAI-compatible endpoint with a free
# developer tier that needs no credit card. It matters here for a reason
# beyond price: answers come back in seconds rather than the 60-180s a local
# CPU model takes, which keeps every request far inside the request budget
# above and inside the platform's function timeout. Get a key at
# https://console.groq.com/keys — it begins `gsk_`.
#
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_your_key_here
#   OPENAI_MODEL=openai/gpt-oss-120b
#
# The `openai/` in that model name is part of the model's ID on Groq, not a
# switch back to OpenAI the company — the model is an open-weights one Groq
# hosts. Both lines are correct together.
#
# Hosted model names are not stable. Groq retires them on a published
# schedule: `llama-3.3-70b-versatile`, which this file recommended earlier,
# left the free tier in August 2026. If a request fails with a 404 or
# "model not found", the model was retired, and the fix is this one variable.
# The current free-tier list is at https://console.groq.com/docs/rate-limits —
# a model has a free tier if and only if it appears in that table.
#
# The free tier is rate limited (per-minute requests and tokens). Hitting it
# returns a plainly-worded "try again shortly", and the deterministic analysis
# is unaffected — it never goes near the model.
#
# --- OpenAI itself (paid; no free tier) -------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# --- Anything else ----------------------------------------------------------
# Together, OpenRouter, vLLM, LM Studio: set the base URL and model name.
#
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b

# --- Demo data --------------------------------------------------------------
# Allows the public demo (POST /auth/demo) and the "Use sample data" button.
# Set to false to remove the unauthenticated demo endpoint entirely.
DEMO_DATA_ENABLED=true
# How long a public demo workspace lives before it and its files are deleted.
DEMO_SESSION_HOURS=24
