# =============================================================================
# InsightFlow AI — frontend configuration
# Copy to `.env.local` for development. NEVER commit real secrets.
# =============================================================================

# Where the FastAPI backend is reachable from the Next.js *server*.
# The browser never contacts this directly — all traffic is proxied through
# Next.js route handlers so the session cookie stays first-party.
#
# Set this for local development only. On Vercel it is injected automatically:
# `vercel.json` declares a service binding to the `api` service, and Vercel
# generates the value. Do not set it in the Vercel dashboard — a value you set
# by hand would be a fixed hostname, and the binding's value is
# deployment-aware, so a preview deployment's frontend reaches that same
# preview's backend rather than production's.
BACKEND_API_URL=http://localhost:8000

# There is deliberately NO frontend signing key.
#
# The session cookie carries the JWT the backend issued, which the backend
# already signed with its own SECRET_KEY and verifies on every request. A second
# key here would sign a value that is itself a signature: it could not detect
# tampering the backend does not already reject, and it would be one more secret
# to rotate. The cookie is httpOnly, so the browser cannot read it either way.

# Public site URL, used for metadata and social preview tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the "Load sample data" affordance in onboarding.
NEXT_PUBLIC_DEMO_ENABLED=true

# The largest file the upload form will accept, in megabytes. Defaults to 50.
#
# Browser-visible on purpose: it is printed on the dropzone and enforced before
# a byte is sent. Not a secret — the form reveals it by rejecting anything
# bigger.
#
# It is a variable because the ceiling belongs to the platform, not the product.
# A Vercel Function accepts at most 4.5 MB of request body and answers anything
# larger with its own FUNCTION_PAYLOAD_TOO_LARGE, before this application runs
# at all. Set 4 on Vercel and the limit is explained in the product's own
# words; leave it unset anywhere else. Keep it at or below MAX_UPLOAD_SIZE_MB
# in the backend environment.
# NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Repository link shown in the marketing footer.
NEXT_PUBLIC_SOURCE_URL=https://github.com/zain-ul-abideen-5036/InsightFlow-AI

# Shared secret that lets the backend believe the client address this server
# forwards. Must match PROXY_SHARED_SECRET in the backend environment.
#
# Without it the backend rate-limits on the address it sees, which in production
# is this server — meaning one budget shared by every user. Optional locally,
# where the two are the same machine anyway. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SHARED_SECRET=

# Forces the Secure flag on session cookies on or off. Leave unset: it is
# derived from the protocol the request actually arrived on.
# COOKIE_SECURE=
